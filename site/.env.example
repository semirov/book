# Copy to .env and load with `node --env-file=.env server/dist/index.js`.
# Secrets are never read from here in M0: IP_SALT_FILE, ADMIN_TOKEN_FILE and
# ENGINE_TOKEN_FILE belong to later milestones and live in files with mode 0600.

BOOK_ROOT=/book
DATA_DIR=./.data
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=https://book.semirov.dev
LOG_LEVEL=info
BOOK_TZ=Europe/Moscow

MAX_WS=100
COMMENTS_PER_HOUR=10
QUEUE_SOFT_CAP=25
BUDGET_MAX_WAVE=4
BUDGET_MAX_CHAPTERS=7
BUDGET_MAX_STEPS=14
BUDGET_MAX_WALL_MS=900000
LEASE_TTL_MS=90000
WATCH_POLL_MS=700
