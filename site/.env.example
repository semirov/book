# Copy to .env and load with `node --env-file=.env server/dist/index.js`.
#
# Secrets are FILES, not values (invariant 30, audit M2). The environment carries the PATH
# (`<NAME>_FILE`, a 0600 file whose content is trimmed into the variable); the value lives in
# the file. A mounted file wins over the plain variable in every environment, and in
# NODE_ENV=production a plain value is refused at boot — there is no opt-out, because the value
# would sit in `--env-file`'s environment, `docker inspect` and /proc/1/environ. Development
# and tests may still use the plain variables below. In docker-compose the files arrive as
# `secrets:` mounts at /run/secrets/*.
#   SESSION_SECRET_FILE       IP_SALT_FILE
#   YANDEX_CLIENT_ID_FILE     YANDEX_CLIENT_SECRET_FILE
#   CAPTCHA_SECRET_FILE       (only when a captcha provider is chosen)

# --- Identity (M5, ADR-021) ---
# Yandex OAuth app: type "Для авторизации пользователей", platform "Веб-сервисы",
# redirect URI must match exactly what the browser will call back on.
# PUBLIC_ORIGIN also fixes the default redirect: ${PUBLIC_ORIGIN}/auth/yandex/callback.
PUBLIC_ORIGIN=https://book.semirov.dev
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Optional: overrides the derived redirect (must equal the URI registered in Yandex).
# OAUTH_REDIRECT_URI=https://book.semirov.dev/auth/yandex/callback
# Signs the OAuth `state` cookie. Empty = random per boot, i.e. every restart logs everyone out.
# SESSION_SECRET=<64 hex chars: openssl rand -hex 32>

# The site watches the manuscript read-only. Polling is the OrbStack-safe mode (§6.2).
BOOK_ROOT=/book
DATA_DIR=./.data
# PRODUCTION_DATA_DIR=/Users/filipp/book-site-data  (default: $HOME/book-site-data)
# The boot guard works both ways: a dev/test run may not touch the production data dir, and a
# production run may not keep DATA_DIR inside the checkout (site/.data is the dev/boot default).
WEB_DIST=./web/dist
# The legal gate's source (F005) and the admin panel's guard (§13.4, §17).
# DENYLIST_PATH=./config/legal.denylist.json
# ADMIN_TOKEN_FILE=./.data/admin.token      # a 0600 file; empty/absent = /api/admin/* 404s
# The read-only imprint is config, not prose (F020, §6C.6).
IMPRINT_PATH=./config/imprint.json
# BOOK-126: gift link («поддержать книгу»); public, not a *_FILE; empty = no row; https://t.tb.ru/… only.
DONATE_URL=
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=https://book.semirov.dev
LOG_LEVEL=info
BOOK_TZ=Europe/Moscow

MAX_WS=100
# 20 readers per network: a household fits, and one address can hold at most a fifth of the
# 100-seat hall. Over either cap the newcomer is refused, never an open seat (§10.1).
WS_PER_IP=20
WS_HEARTBEAT_MS=30000
# X-Forwarded-For is believed only when the socket peer is in this list (§14). The proxy is
# one host, not a subnet (audit m1): a /24 would let any LAN machine forge its own address.
TRUSTED_PROXIES=127.0.0.1,::1,192.168.1.44/32
# Per-network read budget for /api/history, /api/state and /api/changes (audit M6).
READ_PER_MINUTE=60
# §14: 10 comments/hour per network AND per identity; one reader edit per day (SPEC).
COMMENTS_PER_HOUR_IP=10
COMMENTS_PER_HOUR_IDENTITY=10
# One edit/day per identity AND per hashed network (BOOK-DOC-4 rule 5): a household behind
# one address shares the day's edit. Same number, two keys (`edit:id:`, `edit:ip:`).
EDIT_SUBMISSIONS_PER_DAY=1
QUEUE_SOFT_CAP=15
# The file exchange with triage (§12.2, §12.6): batches + decisions.jsonl.
# Empty = <site>/data/feedback; EXCHANGE_DIR is the container mount.
# FEEDBACK_DIR=./data/feedback

# ── identity / Yandex OAuth (ADR-021) ──────────────────────────────────────────
# PLACEHOLDERS: the owner registers an OAuth app at https://oauth.yandex.ru and supplies
# the real values. Empty YANDEX_CLIENT_ID/SECRET leaves the site readable and sign-in off
# (503 OAUTH_UNCONFIGURED); it never opens an unprotected write path.
# Local dev only: in production both arrive from 0600 files and the plain value is refused.
# Sign-in is optional — omit id, secret and both *_FILE paths and the site stays readable.
#   YANDEX_CLIENT_ID_FILE=./secrets/yandex_client_id
#   YANDEX_CLIENT_SECRET_FILE=./secrets/yandex_client_secret
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Defaults to ${PUBLIC_ORIGIN}/auth/yandex/callback when empty.
YANDEX_REDIRECT_URI=https://book.semirov.dev/auth/yandex/callback
OAUTH_START_PER_HOUR=10
OAUTH_STATE_TTL_MS=600000
SESSION_TTL_MS=2592000000
# Secrets: paths here, values in 0600 files (`./secrets/*`, mounted by the operator; see
# docker-compose.yml). In NODE_ENV=production a plain value below is refused at boot and an
# empty one too — an ephemeral per-boot secret is a local-dev shape only, by design.
#   SESSION_SECRET_FILE=./secrets/session_secret
#   IP_SALT_FILE=./secrets/ip_salt
SESSION_SECRET=
IP_SALT=

# ── CAPTCHA (BOOK-64) ──────────────────────────────────────────────────────────
# turnstile | hcaptcha | none. The shipped value is `none`: the write gate is the
# authenticated Yandex identity plus the comment and edit rate limits (no challenge).
CAPTCHA_PROVIDER=none
# Only when a provider is chosen — both together, or the boot fails loudly:
#   CAPTCHA_SITE_KEY=<public site key from the provider dashboard>
# In production the secret is a 0600 file, not an env value:
#   CAPTCHA_SECRET_FILE=./secrets/captcha_secret
# A published vendor TEST key (1x00000000000000000000AA, 1x0000000000000000000000000000000AA,
# hCaptcha's 10000000-ffff-… pair, …) is refused at boot (audit B1): it accepts any token.
CAPTCHA_TIMEOUT_MS=3000

# Yandex Metrika counter; empty = no script, no request and no Yandex origin in the CSP
# (§15.6, BOOK-63). The owner's counter is 113820311; consent (and Do Not Track) still gates
# the script, so a configured id only makes the counter *available*, never automatic.
METRIKA_ID=
# Cascade bounds, frozen per cascade at open (§6A.6, §6D.2). BOOK-59: a change makes one wave
# — one round of both wings, forward and forward-back — so a ripple bounded by W waves is 2W
# steps over 2W chapters, plus at most a front and an ending proof. BOOK-DOC-4 rule 3 is a
# public promise, so BUDGET_MAX_WAVE may only restate CASCADE_MAX_WAVE (1) — the boot refuses
# any other value; BUDGET_MAX_STEPS must stay at least 2·W+2 and BUDGET_MAX_CHAPTERS at least
# 2·W, or a bound binds first and the wave bound is dead; BUDGET_UPWARD_LAG_WAVES must stay
# below W, or the upward wing never gets a wave. A second wave is not a budget failure: it
# opens only by the owner's decision. The per-cascade token ceiling (BUDGET_MAX_TOKENS) and
# BUDGET_MAX_WALL_MS cap the cost and the time of that one wave.
BUDGET_MAX_WAVE=1
BUDGET_MAX_CHAPTERS=12
BUDGET_MAX_STEPS=13
BUDGET_MAX_WALL_MS=1800000
BUDGET_MAX_TOKENS=1500000
BUDGET_DAILY_TOKENS=24000000
BUDGET_MAX_REWRITES_PER_CHAPTER=1
BUDGET_UPWARD_LAG_WAVES=0
BUDGET_MAX_DELTA_RATIO=0.35
GATE_CYCLES=3
# How long a gate may read before its dispatch is dead. A real editor read takes 4–7 minutes, so a
# five-minute window killed a normal pass (2026-10-28): the engine's own beat extends a live
# dispatch, and STEP_WALL_MS is what still bounds the step.
GATE_TTL_MS=1200000
LEASE_TTL_MS=120000
# BOOK-34: the step wall, measured from `steps.at` (the step's opening). The engine beats its lease
# (a real pass outlives LEASE_TTL_MS), so this is the only bound on a step's growth: past it
# the reaper escalates the step and releases its lease. Must be at least LEASE_TTL_MS.
STEP_WALL_MS=2700000
LANE_TTL_MS=90000
ENGINE_REAPER_MS=15000
ENGINE_MAX_CONCURRENT_STEPS=2
ENGINE_MAX_CONCURRENT_PROCESSES=6
# The engine's own process: compose network only, no host port (§4.2).
# ENGINE_PORT=8081
# ENGINE_HOST=127.0.0.1
# The CLI reads the same token; it is minted into DATA_DIR on first local start.
# ENGINE_TOKEN_FILE=./.data/engine.token
WATCH_POLL_MS=700
WATCH_COALESCE_MS=1500
EMPTY_WRITE_GRACE_MS=5000

# ── Containers (BOOK-172) ──────────────────────────────────────────────────────
# A container does NOT read this file. `site/deploy/compose-release.sh` and `flip.sh` always call
# `docker compose --env-file /dev/null`, and the compose file declares every variable itself, so a
# launchd path or a plain value in `.env` can never reach a service. These are the only knobs: the
# defaults are prod-real and a rehearsal overrides them (see the `book-rehearsal` commands in the
# README). They are read by the shell, not by the service.
#   BOOK_IMAGE_TAG=book:<sha>                 # set by the release script, never by hand
#   BOOK_SITE_PUBLISH=192.168.1.76:8091       # LAN address Caddy proxies to; 8092 in a rehearsal
#   BOOK_DATA_VOLUME=book-data                # the named volume the services serve from (BOOK-183);
#                                             # a rehearsal uses its own name, never the prod one
#   BOOK_BACKUPS_DIR=/Users/filipp/book-site-backups   # mounted at /backups in site: backup output only
#   BOOK_SECRETS_DIR=./secrets                # 0600 files: session_secret, ip_salt
#   BOOK_LOCKS_DIR=/Users/filipp/.local/state/book-locks
#   BOOK_HOST_DATA_DIR=/Users/filipp/book-site-data    # only the launchd fallback + the migration use it
#   BOOK_DEEPSEEK_KEY_FILE=/Users/filipp/.config/book/deepseek.key
#   BOOK_DRAFTING=on                          # the owner's writing switch, on the engine service
#   BOOK_TRUSTED_PROXIES=127.0.0.1/32,::1/128,192.168.1.44/32
#   BOOK_WRITER_MAX_PASSES_PER_DAY / BOOK_WRITER_MAX_TOKENS_PER_CALL / BOOK_WRITER_PAUSE_MS
# The engine's boot uses the same config as the site: it needs SESSION_SECRET_FILE and IP_SALT_FILE
# too (both services mount the same two 0600 files).
