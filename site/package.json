{
  "name": "book-site",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "book.semirov.dev — the book, written in public",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "prebuild": "node scripts/build-info.mjs",
    "build": "npm run build -w @book/shared && npm run build -w @book/server && npm run build -w @book/web && node scripts/sw-build.mjs",
    "release:publish": "node scripts/release.mjs publish",
    "proof": "tsx scripts/proof-release.ts",
    "typecheck": "npm run build -w @book/shared && tsc -p shared/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "arch": "node scripts/arch.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:affected": "node scripts/affected-tests.mjs",
    "test:merge": "vitest run --merge-reports=.vitest-reports --coverage",
    "check:orphans": "node scripts/orphan-check.mjs",
    "frame:check": "node scripts/frame-check.mjs",
    "type:stability": "node scripts/type-stability.mjs",
    "validate": "node bin/validate.mjs",
    "start": "node server/dist/index.js",
    "engine": "node server/dist/engine.js",
    "engine:cli": "node bin/engine.mjs",
    "writer": "node server/dist/writer/main.js",
    "writer:dev": "node --import tsx server/src/writer/main.ts",
    "dev": "node scripts/dev.mjs",
    "verify": "npm run typecheck && npm run arch && npm run frame:check",
    "test:model": "node model-lane/run.mjs",
    "test:model:pass": "node model-lane/pass.mjs",
    "accordion:cdp": "node scripts/accordion-cdp.mjs",
    "line:fonts": "node scripts/line-fonts-cdp.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
