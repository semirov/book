{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@book/shared": [
        "./shared/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "shared/test/**/*.ts",
    "server/test/**/*.ts",
    "test/**/*.ts",
    "web/src/**/*.test.{ts,tsx}",
    "vitest.config.ts"
  ]
}
