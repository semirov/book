root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
# Licence texts are copied verbatim and may carry upstream trailing whitespace.
trim_trailing_whitespace = false

[*.md]
# Markdown indentation is not enforced: prose and tables decide their own layout.
indent_size = unset
